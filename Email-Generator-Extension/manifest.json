{
  "name": "Email Generator Assistant by Prakash",
  "description": "AI-powered email Assistant",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://ai-email-generator-1-3skg.onrender.com/api/email/generate",
    "*://mail.google.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://mail.google.com/*"
      ]
    }
  ],

  "action": {
    "default_title": "Email Writer Assistant",
    "default_icon": "hello_extensions.png"
  }
}
